{
  "name": "proxylang",
  "version": "0.1.5",
  "description": "Composable routing policies in TypeScript with explicit platform targets",
  "homepage": "https://github.com/CorrectRoadH/proxylang#readme",
  "bugs": {
    "url": "https://github.com/CorrectRoadH/proxylang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorrectRoadH/proxylang.git"
  },
  "bin": {
    "proxylang": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "vp exec tsc --noEmit -p tsconfig.check.json",
    "test": "vp test run",
    "test:native": "PROXYLANG_NATIVE_CHECK=1 vp test run test/native.test.ts",
    "check": "vp pack && vp check && vp run typecheck && vp test run",
    "docs:check": "concord check --fresh",
    "docs:gaps": "concord trace gaps --fresh",
    "example:check": "vp exec node dist/cli.js check examples/home.ts",
    "example:build": "vp exec node dist/cli.js build examples/home.ts --out out",
    "test:package": "vp pack && vp exec node scripts/verify-package.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.12.1"
}
