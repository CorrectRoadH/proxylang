{
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "pl-direct"
    },
    {
      "type": "trojan",
      "tag": "edge",
      "server": "192.0.2.10",
      "server_port": 443,
      "password": "test-only",
      "tls": {
        "enabled": true,
        "server_name": "proxy.example.com"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "rule_set": [
          "external"
        ],
        "action": "route",
        "outbound": "pl-direct"
      },
      {
        "domain_suffix": [
          "example.com"
        ],
        "action": "route",
        "outbound": "edge"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "external",
        "url": "https://rules.example.com/list.json",
        "format": "source",
        "update_interval": "86400s",
        "download_detour": "pl-direct"
      }
    ],
    "final": "edge"
  }
}
