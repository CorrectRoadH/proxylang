{
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "pl-direct"
    },
    {
      "type": "trojan",
      "tag": "edge",
      "server": "192.0.2.10",
      "server_port": 443,
      "password": "test-only",
      "tls": {
        "enabled": true,
        "server_name": "proxy.example.com"
      }
    },
    {
      "type": "selector",
      "tag": "Choice",
      "outbounds": [
        "edge"
      ],
      "default": "edge",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "Automatic",
      "outbounds": [
        "edge"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "180s",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "Speed",
      "outbounds": [
        "edge"
      ],
      "url": "https://example.com/check",
      "interval": "180s",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "example.com"
        ],
        "action": "route",
        "outbound": "edge"
      },
      {
        "port": [
          2000
        ],
        "action": "route",
        "outbound": "Choice"
      },
      {
        "port": [
          2001
        ],
        "action": "route",
        "outbound": "Automatic"
      },
      {
        "port": [
          2002
        ],
        "action": "route",
        "outbound": "Speed"
      }
    ],
    "final": "edge",
    "default_domain_resolver": {
      "server": "pl-dns",
      "strategy": "prefer_ipv4"
    }
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "pl-listener",
      "listen": "127.0.0.1",
      "listen_port": 16900
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "pl-dns",
        "server": "192.0.2.53",
        "server_port": 53
      }
    ],
    "final": "pl-dns",
    "strategy": "prefer_ipv4"
  }
}
