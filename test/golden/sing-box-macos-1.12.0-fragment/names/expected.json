{
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "pl-direct"
    },
    {
      "type": "trojan",
      "tag": "Edge Example",
      "server": "192.0.2.10",
      "server_port": 443,
      "password": "test-only",
      "tls": {
        "enabled": true,
        "server_name": "proxy.example.com"
      }
    },
    {
      "type": "http",
      "tag": "Chained Example",
      "server": "192.0.2.20",
      "server_port": 8080,
      "detour": "Route Choice",
      "password": "test-only"
    },
    {
      "type": "selector",
      "tag": "Route Choice",
      "outbounds": [
        "Edge Example"
      ],
      "default": "Edge Example",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "domain": [
          "choice.example"
        ],
        "action": "route",
        "outbound": "Route Choice"
      },
      {
        "network": [
          "tcp"
        ],
        "action": "route",
        "outbound": "Chained Example"
      },
      {
        "domain_suffix": [
          "example.com"
        ],
        "action": "route",
        "outbound": "Edge Example"
      }
    ],
    "final": "Edge Example"
  }
}
