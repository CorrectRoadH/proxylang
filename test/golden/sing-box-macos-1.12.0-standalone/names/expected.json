{
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "pl-direct"
    },
    {
      "type": "trojan",
      "tag": "Edge Example",
      "server": "192.0.2.10",
      "server_port": 443,
      "password": "test-only",
      "tls": {
        "enabled": true,
        "server_name": "proxy.example.com"
      }
    },
    {
      "type": "http",
      "tag": "Chained Example",
      "server": "192.0.2.20",
      "server_port": 8080,
      "detour": "Route Choice",
      "password": "test-only"
    },
    {
      "type": "selector",
      "tag": "Route Choice",
      "outbounds": [
        "Edge Example"
      ],
      "default": "Edge Example",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "domain": [
          "mesh.example"
        ],
        "action": "route",
        "outbound": "Mesh Example"
      },
      {
        "domain": [
          "choice.example"
        ],
        "action": "route",
        "outbound": "Route Choice"
      },
      {
        "network": [
          "tcp"
        ],
        "action": "route",
        "outbound": "Chained Example"
      },
      {
        "domain_suffix": [
          "example.com"
        ],
        "action": "route",
        "outbound": "Edge Example"
      }
    ],
    "final": "Edge Example",
    "default_domain_resolver": {
      "server": "pl-dns",
      "strategy": "prefer_ipv4"
    }
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "pl-listener",
      "listen": "127.0.0.1",
      "listen_port": 16900
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "pl-dns",
        "server": "192.0.2.53",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "pl-ts-dns-named-mesh",
        "server": "192.0.2.53",
        "server_port": 53
      }
    ],
    "final": "pl-dns",
    "strategy": "prefer_ipv4"
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "Mesh Example",
      "hostname": "example-device",
      "state_directory": "/var/lib/example-named-mesh",
      "accept_routes": true,
      "domain_resolver": {
        "server": "pl-ts-dns-named-mesh"
      }
    }
  ]
}
